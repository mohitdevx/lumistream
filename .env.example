# Backend server port
PORT=5000

# PostgreSQL connection string
# Used locally: localhost, inside docker-compose it will be overridden to "db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lumistream?schema=public"

# Redis Server URL
REDIS_URL="redis://localhost:6379"

# Frontend environment variables (Vite requires VITE_ prefix)
VITE_API_URL="http://localhost:5000"
VITE_WS_URL="http://localhost:5000"
